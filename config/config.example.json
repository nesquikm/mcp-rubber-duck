{
  "providers": {
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "https://api.openai.com/v1",
      "models": ["gpt-5.4", "gpt-5.4-mini", "gpt-6.1-sol"],
      "default_model": "gpt-5.4",
      "nickname": "GPT Duck",
      "temperature": 0.7
    },
    "gemini": {
      "api_key": "${GEMINI_API_KEY}",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "models": ["gemini-3.8-flash", "gemini-4-argon", "gemini-3.1-flash-lite"],
      "default_model": "gemini-3.8-flash",
      "nickname": "Gemini Duck",
      "temperature": 0.7
    },
    "groq": {
      "api_key": "${GROQ_API_KEY}",
      "base_url": "https://api.groq.com/openai/v1",
      "models": ["openai/gpt-oss-120b", "openai/gpt-oss-20b"],
      "default_model": "openai/gpt-oss-120b",
      "nickname": "Groq Duck",
      "temperature": 0.7
    },
    "together": {
      "api_key": "${TOGETHER_API_KEY}",
      "base_url": "https://api.together.xyz/v1",
      "models": ["zai-org/GLM-5.3", "Qwen/Qwen3.8-Flash"],
      "default_model": "zai-org/GLM-5.3",
      "nickname": "Together Duck",
      "temperature": 0.7
    },
    "perplexity": {
      "api_key": "${PERPLEXITY_API_KEY}",
      "base_url": "https://api.perplexity.ai",
      "models": ["sonar", "sonar-pro"],
      "default_model": "sonar",
      "nickname": "Perplexity Duck",
      "temperature": 0.7
    },
    "azure_openai": {
      "api_key": "${AZURE_OPENAI_API_KEY}",
      "base_url": "https://${AZURE_OPENAI_ENDPOINT}.openai.azure.com",
      "models": ["gpt-4", "gpt-35-turbo"],
      "default_model": "gpt-4",
      "nickname": "Azure Duck",
      "temperature": 0.7
    },
    "local_ollama": {
      "api_key": "not-needed",
      "base_url": "http://localhost:11434/v1",
      "models": ["llama3.2", "mistral", "codellama", "phi3"],
      "default_model": "llama3.2",
      "nickname": "Local Ollama Duck",
      "temperature": 0.7,
      "timeout": 60000
    },
    "local_lmstudio": {
      "api_key": "not-needed",
      "base_url": "http://localhost:1234/v1",
      "models": ["local-model"],
      "default_model": "local-model",
      "nickname": "LM Studio Duck",
      "temperature": 0.7
    },
    "custom": {
      "api_key": "${CUSTOM_API_KEY}",
      "base_url": "${CUSTOM_BASE_URL}",
      "models": ["custom-model"],
      "default_model": "custom-model",
      "nickname": "Custom Duck",
      "temperature": 0.7,
      "system_prompt": "You are a helpful assistant."
    },
    "cli-claude": {
      "type": "cli",
      "cli_type": "claude",
      "nickname": "Claude Agent",
      "system_prompt": "Be concise and technical"
    },
    "cli-codex": {
      "type": "cli",
      "cli_type": "codex",
      "nickname": "Codex Agent"
    },
    "cli-gemini": {
      "type": "cli",
      "cli_type": "gemini",
      "nickname": "Gemini Agent"
    },
    "cli-grok": {
      "type": "cli",
      "cli_type": "grok",
      "nickname": "Grok Agent"
    },
    "cli-aider": {
      "type": "cli",
      "cli_type": "aider",
      "nickname": "Aider Agent"
    },
    "cli-custom-tool": {
      "type": "cli",
      "cli_type": "custom",
      "cli_command": "/usr/local/bin/my-llm",
      "prompt_delivery": "stdin",
      "output_format": "text",
      "nickname": "My Custom CLI Tool",
      "process_timeout": 120000
    }
  },
  "default_provider": "openai",
  "default_temperature": 0.7,
  "enable_failover": true,
  "log_level": "info"
}