  {
    "name": "ask_duck",
    "title": "Ask a Duck",
    "description": "Ask a question to a specific LLM provider (duck) with MCP tool access",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The question or prompt to send to the duck"
        },
        "provider": {
          "description": "The provider name (optional, uses default if not specified)",
          "type": "string",
          "enum": [
            "openai"
          ]
        },
        "model": {
          "description": "Specific model to use (optional, uses provider default if not specified)",
          "type": "string"
        },
        "temperature": {
          "description": "Temperature for response generation (0-2)",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "images": {
          "description": "Optional images to include with the prompt (for vision-capable models)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "description": "Base64-encoded image data",
                "type": "string"
              },
              "url": {
                "description": "Image URL — passed directly to the LLM provider",
                "type": "string"
              },
              "mimeType": {
                "description": "MIME type (e.g., \"image/png\") — required for base64 data, optional for URLs",
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "prompt"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    }
