  {
    "name": "duck_debate",
    "title": "Duck Debate",
    "description": "Structured multi-round debate between ducks. Supports oxford (pro/con), socratic (questioning), and adversarial (attack/defend) formats.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The debate topic or proposition"
        },
        "rounds": {
          "default": 3,
          "description": "Number of debate rounds (default: 3)",
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "providers": {
          "description": "Provider names to participate (min 2, uses all if not specified)",
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "openai"
            ]
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "oxford",
            "socratic",
            "adversarial"
          ],
          "description": "Debate format: oxford (pro/con), socratic (questioning), adversarial (attack/defend)"
        },
        "synthesizer": {
          "description": "Provider to synthesize the debate (optional, uses first provider)",
          "type": "string",
          "enum": [
            "openai"
          ]
        }
      },
      "required": [
        "prompt",
        "format"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "oxford",
            "socratic",
            "adversarial"
          ]
        },
        "totalRounds": {
          "type": "number"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "nickname": {
                "type": "string"
              },
              "position": {
                "type": "string",
                "enum": [
                  "pro",
                  "con",
                  "neutral"
                ]
              }
            },
            "required": [
              "provider",
              "nickname",
              "position"
            ],
            "additionalProperties": false
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "round": {
                  "type": "number"
                },
                "provider": {
                  "type": "string"
                },
                "nickname": {
                  "type": "string"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "pro",
                    "con",
                    "neutral"
                  ]
                },
                "content": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "round",
                "provider",
                "nickname",
                "position",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "synthesis": {
          "type": "string"
        },
        "synthesizer": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "format",
        "totalRounds",
        "participants",
        "rounds",
        "synthesis",
        "synthesizer"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
