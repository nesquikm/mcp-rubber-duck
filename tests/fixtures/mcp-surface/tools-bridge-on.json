          "items": {
            "type": "string",
            "enum": [
              "openai"
            ]
          }
        },
        "model": {
          "description": "Specific model to use for all providers (optional)",
          "type": "string"
        },
        "images": {
          "description": "Optional images to include with the prompt (for vision-capable models)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "description": "Base64-encoded image data",
                "type": "string"
              },
              "url": {
                "description": "Image URL — passed directly to the LLM provider",
                "type": "string"
              },
              "mimeType": {
                "description": "MIME type (e.g., \"image/png\") — required for base64 data, optional for URLs",
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "prompt"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "nickname": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "latency": {
                "type": "number"
              },
              "tokens": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "number"
                      },
                      "completion": {
                        "type": "number"
                      },
                      "total": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "prompt",
                      "completion",
                      "total"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "nickname",
              "model",
              "content",
              "latency",
              "tokens"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "responses"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
